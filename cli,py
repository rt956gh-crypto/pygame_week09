import sys
import os
import pygame
import requests

API_BASE_URL = "https://wordle-server-a076.onrender.com"

COLOR_BG = (18, 18, 19)
COLOR_TEXT = (255, 255, 255)
COLOR_EMPTY = (58, 58, 60)
COLOR_CORRECT = (83, 141, 78)   # 綠色
COLOR_PRESENT = (181, 159, 59)  # 黃色
COLOR_ABSENT = (58, 58, 60)     # 灰色

pygame.init()
WIDTH, HEIGHT = 700, 650
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Pygame Wordle + FastAPI Client")
font = pygame.font.SysFont("Arial", 36, bold=True)
small_font = pygame.font.SysFont("Arial", 18)

class WordleGame:
    def __init__(self):
        self.game_id = None
        self.grid = [["" for _ in range(5)] for _ in range(6)]
        self.colors = [[COLOR_EMPTY for _ in range(5)] for _ in range(6)]
        self.row = 0
        self.col = 0
        self.game_over = False
        self.message = "Press ENTER to submit, R to restart, H to toggle Hard Mode"
        
        self.history_guesses = []
        self.total_games = 0
        self.wins = 0
        self.win_rate = 0.0
        
        self.hard_mode = False
        self.start_new_game()

    def fetch_stats(self):
        """ 主動向後端 /api/stats 請求最新數據 """
        try:
            res = requests.get(f"{API_BASE_URL}/api/stats", timeout=10)
            if res.status_code == 200:
                data = res.json()
                self.total_games = data.get("total_games", 0)
                self.wins = data.get("wins", 0)
                self.win_rate = data.get("win_rate", 0.0)
        except requests.exceptions.RequestException:
            pass

    def start_new_game(self):
        try:
            payload = {"hard_mode": self.hard_mode}
            res = requests.post(f"{API_BASE_URL}/api/new-game", json=payload, timeout=60)
            if res.status_code == 200:
                self.game_id = res.json()["game_id"]
                self.grid = [["" for _ in range(5)] for _ in range(6)]
                self.colors = [[COLOR_EMPTY for _ in range(5)] for _ in range(6)]
                self.row = 0
                self.col = 0
                self.game_over = False
                self.history_guesses = []
                mode_str = "HARD" if self.hard_mode else "Normal"
                self.message = f"New game started! Mode: {mode_str}"
                
                # 每次開新局立即更新一次統計數據
                self.fetch_stats()
        except requests.exceptions.RequestException:
            self.message = "Cannot connect to FastAPI server!"

    def submit_guess(self):
        if self.col < 5:
            self.message = "Not enough letters!"
            return

        guess_word = "".join(self.grid[self.row])
        try:
            payload = {"game_id": self.game_id, "guess": guess_word}
            res = requests.post(f"{API_BASE_URL}/api/guess", json=payload, timeout=60)
            
            if res.status_code == 200:
                data = res.json()
                feedback = data["feedback"]
                
                # 確保這裡確實有把後端回傳的統計更新到 self 變數中！
                self.total_games = data.get("total_games", self.total_games)
                self.wins = data.get("wins", self.wins)
                self.win_rate = data.get("win_rate", self.win_rate)
                
                self.history_guesses.append(guess_word)
                
                for i in range(5):
                    if feedback[i] == "correct":
                        self.colors[self.row][i] = COLOR_CORRECT
                    elif feedback[i] == "present":
                        self.colors[self.row][i] = COLOR_PRESENT
                    else:
                        self.colors[self.row][i] = COLOR_ABSENT

                if data["is_correct"]:
                    self.message = "Congratulations! You won! Press R to restart."
                    self.game_over = True
                    # 贏的時候順便同步更新一次統計
                    self.fetch_stats()
                else:
                    self.row += 1
                    self.col = 0
                    if self.row == 6:
                        target_word = data.get("target_word", "")
                        self.message = f"Game Over! The word was {target_word}. Press R to restart."
                        self.game_over = True
                        # 輸的時候也同步更新一次統計
                        self.fetch_stats()
                    else:
                        tries_left = 6 - self.row
                        self.message = f"Keep guessing! ({tries_left} tries left)"
            else:
                detail = res.json().get("detail", "Error processing guess")
                if detail == "Word not in directory":
                    self.message = "Not in word list!"
                elif "Hard Mode" in detail:
                    self.message = "Hard Mode: Must use revealed hint!"
                else:
                    self.message = detail
        except requests.exceptions.RequestException:
            self.message = "Network error during guess!"

    def handle_keydown(self, event):
        # 1. R 鍵：只有在遊戲結束時才能用來重新開始遊戲
        if event.key == pygame.K_r:
            if self.game_over:
                self.start_new_game()
            else:
                # 遊戲進行中時，若想輸入字母 R 且格子未滿，直接填入格子
                if self.col < 5:
                    self.grid[self.row][self.col] = "R"
                    self.col += 1
            return

        # 2. H 鍵：只有在該行還沒輸入字母 (col == 0) 且未結束時按 H 才會切換模式；
        #    若正在輸入單字中，則將 H 視為一般字母輸入！
        if event.key == pygame.K_h:
            if self.col == 0 and not self.game_over:
                self.hard_mode = not self.hard_mode
                self.start_new_game()
            else:
                if self.col < 5:
                    self.grid[self.row][self.col] = "H"
                    self.col += 1
            return

        if self.game_over:
            return

        if event.key == pygame.K_BACKSPACE:
            if self.col > 0:
                self.col -= 1
                self.grid[self.row][self.col] = ""
        elif event.key == pygame.K_RETURN:
            self.submit_guess()
        elif event.unicode.isalpha() and len(event.unicode) == 1:
            if self.col < 5:
                self.grid[self.row][self.col] = event.unicode.upper()
                self.col += 1

    def draw(self, surface):
        surface.fill(COLOR_BG)
        
        # 1. 繪製主網格
        margin_x, margin_y = 50, 50
        box_size = 60
        gap = 10

        for r in range(6):
            for c in range(5):
                x = margin_x + c * (box_size + gap)
                y = margin_y + r * (box_size + gap)
                rect = pygame.Rect(x, y, box_size, box_size)
                
                pygame.draw.rect(surface, self.colors[r][c], rect, border_radius=4)
                if self.colors[r][c] == COLOR_EMPTY:
                    pygame.draw.rect(surface, (80, 80, 80), rect, width=2, border_radius=4)

                char = self.grid[r][c]
                if char:
                    text_surface = font.render(char, True, COLOR_TEXT)
                    text_rect = text_surface.get_rect(center=rect.center)
                    surface.blit(text_surface, text_rect)

        # 2. 繪製右側側邊欄與勝率統計
        sidebar_x = 490
        pygame.draw.line(surface, (80, 80, 80), (sidebar_x, 30), (sidebar_x, HEIGHT - 80), 2)

        stats_text = f"Total: {self.total_games} | Wins: {self.wins} | Win Rate: {self.win_rate}%"
        stats_surface = small_font.render(stats_text, True, COLOR_TEXT)
        surface.blit(stats_surface, (sidebar_x + 15, 50))

        # 任務四：畫面右上角顯示目前模式 ("Mode: Normal" 或 "Mode: HARD")
        mode_display = "Mode: HARD" if self.hard_mode else "Mode: Normal"
        mode_color = (255, 100, 100) if self.hard_mode else (100, 255, 100)
        mode_surface = small_font.render(mode_display, True, mode_color)
        surface.blit(mode_surface, (sidebar_x + 15, 80))

        history_title = small_font.render("Guess History:", True, (180, 180, 180))
        surface.blit(history_title, (sidebar_x + 15, 120))

        for idx, guessed_word in enumerate(self.history_guesses):
            small_word_surface = small_font.render(f"{idx + 1}. {guessed_word}", True, COLOR_TEXT)
            surface.blit(small_word_surface, (sidebar_x + 20, 155 + idx * 30))

        # 3. 畫底部提示訊息
        msg_surface = small_font.render(self.message, True, COLOR_TEXT)
        msg_rect = msg_surface.get_rect(center=(WIDTH // 2, HEIGHT - 40))
        surface.blit(msg_surface, msg_rect)

def main():
    clock = pygame.time.Clock()
    game = WordleGame()

    while True:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            elif event.type == pygame.KEYDOWN:
                game.handle_keydown(event)

        game.draw(screen)
        pygame.display.flip()
        clock.tick(30)

if __name__ == "__main__":
    main()
